---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  eager?: boolean;
}
const { src, alt, class: cls = '', eager = false } = Astro.props;
---

<div class:list={['phone', cls]}>
  <div class="screen">
    <Image src={src} alt={alt} widths={[240, 360, 520]} sizes="(max-width: 700px) 40vw, 260px" loading={eager ? 'eager' : 'lazy'} />
  </div>
</div>

<style>
  .phone {
    width: 100%;
    aspect-ratio: 9 / 19.2;
    padding: 7px;
    border-radius: 34px;
    background: #1f1f1d;
    border: 1px solid #34342f;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 30px 60px -20px rgba(0, 0, 0, 0.7);
  }
  .screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 27px;
    overflow: hidden;
    background: #fff;
  }
  .screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
</style>
