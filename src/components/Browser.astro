---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  compact?: boolean;
}
const { src, alt, compact = false } = Astro.props;
---

<div class:list={['browser', { compact }]}>
  <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
  <Image src={src} alt={alt} widths={[400, 700, 1100]} sizes="(max-width: 900px) 92vw, 640px" loading="lazy" />
</div>

<style>
  .browser {
    border-radius: 14px;
    overflow: hidden;
    background: #1f1f1d;
    border: 1px solid #34342f;
    box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.7);
  }
  .bar {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
  }
  .bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3d3d38;
  }
  .compact .bar {
    padding: 7px 10px;
  }
  .compact .bar i {
    width: 7px;
    height: 7px;
  }
  img {
    width: 100%;
    background: #fff;
  }
</style>
